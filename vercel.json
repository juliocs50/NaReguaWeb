{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/:slug((?!js$|api$|_next$)[^./]+)/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:slug((?!js$|api$|_next$)[^./]+)",
      "destination": "/index.html"
    }
  ]
}
