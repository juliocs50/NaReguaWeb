{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/:slug((?!js$|api$|_next$|about|privacy|DeleteAccount)[^./]+)/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:slug((?!js$|api$|_next$|about|privacy|DeleteAccount)[^./]+)",
      "destination": "/index.html"
    }
  ]
}
